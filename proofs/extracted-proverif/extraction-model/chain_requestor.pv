(* SPQR extracted model — the epoch-2 requestor's authenticator is compromised.
   Uses `accept_injection.pvl`. Expect true: a transcript accepted at epoch ep
   that the peer did not send needs an authenticator of ep or ep-1 (the CT
   sender's entries for ep-1 include the updated authenticator), a state of
   ep-1, or an injection at ep-1. With heal_requestor.pv: once an epoch after the
   compromise completes without injection, no later transcript can be injected
   and no later key leaks. *)

(* Saturation control (sound: nounif only guides ProVerif's resolution order,
   never the verdict): deprioritize the attacker building symbolic ML-KEM,
   authenticator, MAC and derived-secret terms. *)
nounif spqr_r: bitstring, hdr: bitstring, ss: bitstring;
    attacker(pkenc1(spqr_r, hdr, ss)) / 30000.
nounif spqr_r: bitstring, ek: bitstring;
    attacker(pkenc2(spqr_r, ek)) / 30000.
nounif dk: bitstring; attacker(dk2enckey(dk)) / 30000.
nounif dk: bitstring; attacker(dk2seed(dk)) / 30000.
nounif a: bitstring, e: bitstring, k: bitstring; attacker(auth_update(a, e, k)) / 30000.
nounif rk: bitstring, e: bitstring; attacker(auth_new(rk, e)) / 30000.
nounif a: bitstring, e: bitstring, ct: bitstring; attacker(mac_ct_f(a, e, ct)) / 30000.
nounif a: bitstring, e: bitstring, h: bitstring; attacker(mac_hdr_f(a, e, h)) / 30000.
nounif ss: bitstring, e: bitstring; attacker(derive_scka_secret_f(ss, e)) / 30000.

query sid: session_id, ep, ep_: nat, x, y: principal, h, m, e: bitstring;
    event(AcceptedHdrEk(sid, x, y, ep, h, m, e)) ==> event(SentHdrEk(sid, y, x, ep, h, m, e))
        || event(CompromisedAuth(x, y, sid, ep)) || event(CompromisedAuth(y, x, sid, ep))
        || (ep = ep_ + 1 && (event(CompromisedAuth(x, y, sid, ep_))
            || event(CompromisedAuth(y, x, sid, ep_))
            || event(CompromisedKeysHeaderSent(x, y, sid, ep_))
            || event(CompromisedKeysEkSent(x, y, sid, ep_))
            || event(CompromisedKeysEkSentCt1Received(x, y, sid, ep_))
            || event(CompromisedKeysCt1Sent(y, x, sid, ep_))
            || event(CompromisedKeysCt1SentEkReceived(y, x, sid, ep_))
            || event(CompromisedKeysHeaderSent(y, x, sid, ep_))
            || event(CompromisedKeysEkSent(y, x, sid, ep_))
            || event(CompromisedKeysEkSentCt1Received(y, x, sid, ep_))
            || event(CompromisedKeysCt1Sent(x, y, sid, ep_))
            || event(CompromisedKeysCt1SentEkReceived(x, y, sid, ep_))
            || event(Injected(sid, x, y, ep_))
            || event(Injected(sid, y, x, ep_))));
    event(AcceptedCt(sid, x, y, ep, h, m, e)) ==> event(SentCt(sid, y, x, ep, h, m, e))
        || event(CompromisedAuth(x, y, sid, ep)) || event(CompromisedAuth(y, x, sid, ep))
        || (ep = ep_ + 1 && (event(CompromisedAuth(x, y, sid, ep_))
            || event(CompromisedAuth(y, x, sid, ep_))
            || event(CompromisedKeysHeaderSent(x, y, sid, ep_))
            || event(CompromisedKeysEkSent(x, y, sid, ep_))
            || event(CompromisedKeysEkSentCt1Received(x, y, sid, ep_))
            || event(CompromisedKeysCt1Sent(y, x, sid, ep_))
            || event(CompromisedKeysCt1SentEkReceived(y, x, sid, ep_))
            || event(CompromisedKeysHeaderSent(y, x, sid, ep_))
            || event(CompromisedKeysEkSent(y, x, sid, ep_))
            || event(CompromisedKeysEkSentCt1Received(y, x, sid, ep_))
            || event(CompromisedKeysCt1Sent(x, y, sid, ep_))
            || event(CompromisedKeysCt1SentEkReceived(x, y, sid, ep_))
            || event(Injected(sid, x, y, ep_))
            || event(Injected(sid, y, x, ep_)))).

process SystemAuthRequestor()

(* EXPECTPV
RESULT event(AcceptedHdrEk(sid_6,x_26,y_2,ep_10,h,m,e_2)) ==> event(SentHdrEk(sid_6,y_2,x_26,ep_10,h,m,e_2)) || event(CompromisedAuth(x_26,y_2,sid_6,ep_10)) || event(CompromisedAuth(y_2,x_26,sid_6,ep_10)) || (ep_10 = ep_ + 1 && (event(CompromisedAuth(x_26,y_2,sid_6,ep_)) || event(CompromisedAuth(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysHeaderSent(x_26,y_2,sid_6,ep_)) || event(CompromisedKeysEkSent(x_26,y_2,sid_6,ep_)) || event(CompromisedKeysEkSentCt1Received(x_26,y_2,sid_6,ep_)) || event(CompromisedKeysCt1Sent(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysCt1SentEkReceived(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysHeaderSent(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysEkSent(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysEkSentCt1Received(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysCt1Sent(x_26,y_2,sid_6,ep_)) || event(CompromisedKeysCt1SentEkReceived(x_26,y_2,sid_6,ep_)) || event(Injected(sid_6,x_26,y_2,ep_)) || event(Injected(sid_6,y_2,x_26,ep_)))) is true.
RESULT event(AcceptedCt(sid_6,x_26,y_2,ep_10,h,m,e_2)) ==> event(SentCt(sid_6,y_2,x_26,ep_10,h,m,e_2)) || event(CompromisedAuth(x_26,y_2,sid_6,ep_10)) || event(CompromisedAuth(y_2,x_26,sid_6,ep_10)) || (ep_10 = ep_ + 1 && (event(CompromisedAuth(x_26,y_2,sid_6,ep_)) || event(CompromisedAuth(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysHeaderSent(x_26,y_2,sid_6,ep_)) || event(CompromisedKeysEkSent(x_26,y_2,sid_6,ep_)) || event(CompromisedKeysEkSentCt1Received(x_26,y_2,sid_6,ep_)) || event(CompromisedKeysCt1Sent(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysCt1SentEkReceived(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysHeaderSent(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysEkSent(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysEkSentCt1Received(y_2,x_26,sid_6,ep_)) || event(CompromisedKeysCt1Sent(x_26,y_2,sid_6,ep_)) || event(CompromisedKeysCt1SentEkReceived(x_26,y_2,sid_6,ep_)) || event(Injected(sid_6,x_26,y_2,ep_)) || event(Injected(sid_6,y_2,x_26,ep_)))) is true.
END *)
