(* SPQR extracted model — mutual authentication.
   Expect true: unless an authenticator of an epoch ep' <= ep was compromised
   before, a party emitting a key at epoch ep implies its peer took part in the
   same session and epoch, with the same key and header. *)

(* Saturation control (sound: nounif only guides ProVerif's resolution order,
   never the verdict): deprioritize the attacker building symbolic ML-KEM,
   authenticator, MAC and derived-secret terms. *)
nounif spqr_r: bitstring, hdr: bitstring, ss: bitstring;
    attacker(pkenc1(spqr_r, hdr, ss)) / 30000.
nounif spqr_r: bitstring, ek: bitstring;
    attacker(pkenc2(spqr_r, ek)) / 30000.
nounif dk: bitstring; attacker(dk2enckey(dk)) / 30000.
nounif dk: bitstring; attacker(dk2seed(dk)) / 30000.
nounif a: bitstring, e: bitstring, k: bitstring; attacker(auth_update(a, e, k)) / 30000.
nounif rk: bitstring, e: bitstring; attacker(auth_new(rk, e)) / 30000.
nounif a: bitstring, e: bitstring, ct: bitstring; attacker(mac_ct_f(a, e, ct)) / 30000.
nounif a: bitstring, e: bitstring, h: bitstring; attacker(mac_hdr_f(a, e, h)) / 30000.
nounif ss: bitstring, e: bitstring; attacker(derive_scka_secret_f(ss, e)) / 30000.

(* The EK sender emitting a key implies the CT sender accepted its header. *)
query i: time, j: time, sid: session_id, ep, ep': nat, x, y: principal, sk: bitstring;
    event(EKSenderEmittedKey(sid, x, y, ep, sk))@i ==> event(CTSenderStarted(sid, y, x, ep))
        || (ep' <= ep && event(CompromisedAuth(x, y, sid, ep'))@j && j < i)
        || (ep' <= ep && event(CompromisedAuth(y, x, sid, ep'))@j && j < i).

(* The CT sender emitting a key implies the EK sender started the epoch. *)
query i: time, j: time, sid: session_id, ep, ep': nat, x, y: principal, sk: bitstring;
    event(CTSenderEmittedKey(sid, x, y, ep, sk))@i ==> event(EKSenderStarted(sid, y, x, ep))
        || (ep' <= ep && event(CompromisedAuth(x, y, sid, ep'))@j && j < i)
        || (ep' <= ep && event(CompromisedAuth(y, x, sid, ep'))@j && j < i).

(* Key agreement: the EK sender's key is the CT sender's for this session and epoch. *)
query i: time, j: time, sid: session_id, ep, ep': nat, x, y: principal, sk: bitstring;
    event(EKSenderEmittedKey(sid, x, y, ep, sk))@i ==> event(CTSenderEmittedKey(sid, y, x, ep, sk))
        || (ep' <= ep && event(CompromisedAuth(x, y, sid, ep'))@j && j < i)
        || (ep' <= ep && event(CompromisedAuth(y, x, sid, ep'))@j && j < i).

(* Header agreement: the CT sender emits a key for a header (which commits to the
   encapsulation key) that the EK sender sent for this session and epoch. *)
query i: time, j: time, sid: session_id, ep, ep': nat, x, y: principal, sk: bitstring, hdr: bitstring;
    event(CTSenderEmittedKeyForHeader(sid, x, y, ep, hdr, sk))@i ==> event(EKSenderSentHeader(sid, y, x, ep, hdr))
        || (ep' <= ep && event(CompromisedAuth(x, y, sid, ep'))@j && j < i)
        || (ep' <= ep && event(CompromisedAuth(y, x, sid, ep'))@j && j < i).

(* Key uniqueness: if both roles emit the same key, they agree on the context. *)
query sid, sid': session_id, ep, ep', ep'': nat, x, y, x', y': principal, sk: bitstring;
    event(EKSenderEmittedKey(sid, x, y, ep, sk)) && event(CTSenderEmittedKey(sid', y', x', ep', sk)) ==>
        (x = x' && y = y' && sid = sid' && ep = ep')
        || ((ep'' <= ep || ep'' <= ep') && (event(CompromisedAuth(x, y, sid, ep'')) || event(CompromisedAuth(y, x, sid, ep''))
            || event(CompromisedAuth(x, y, sid', ep'')) || event(CompromisedAuth(y, x, sid', ep'')))).

process System()

(* EXPECTPV
RESULT event(EKSenderEmittedKey(sid_15,x_32,y_11,ep_19,sk))@i ==> event(CTSenderStarted(sid_15,y_11,x_32,ep_19)) || (ep_19 ≥ ep' && event(CompromisedAuth(x_32,y_11,sid_15,ep'))@j && i > j) || (ep_19 ≥ ep' && event(CompromisedAuth(y_11,x_32,sid_15,ep'))@j && i > j) is true.
RESULT event(CTSenderEmittedKey(sid_15,x_32,y_11,ep_19,sk))@i ==> event(EKSenderStarted(sid_15,y_11,x_32,ep_19)) || (ep_19 ≥ ep' && event(CompromisedAuth(x_32,y_11,sid_15,ep'))@j && i > j) || (ep_19 ≥ ep' && event(CompromisedAuth(y_11,x_32,sid_15,ep'))@j && i > j) is true.
RESULT event(EKSenderEmittedKey(sid_15,x_32,y_11,ep_19,sk))@i ==> event(CTSenderEmittedKey(sid_15,y_11,x_32,ep_19,sk)) || (ep_19 ≥ ep' && event(CompromisedAuth(x_32,y_11,sid_15,ep'))@j && i > j) || (ep_19 ≥ ep' && event(CompromisedAuth(y_11,x_32,sid_15,ep'))@j && i > j) is true.
RESULT event(CTSenderEmittedKeyForHeader(sid_15,x_32,y_11,ep_19,hdr_5,sk))@i ==> event(EKSenderSentHeader(sid_15,y_11,x_32,ep_19,hdr_5)) || (ep_19 ≥ ep' && event(CompromisedAuth(x_32,y_11,sid_15,ep'))@j && i > j) || (ep_19 ≥ ep' && event(CompromisedAuth(y_11,x_32,sid_15,ep'))@j && i > j) is true.
RESULT event(EKSenderEmittedKey(sid_15,x_32,y_11,ep_19,sk)) && event(CTSenderEmittedKey(sid',y',x',ep',sk)) ==> (x_32 = x' && y_11 = y' && sid_15 = sid' && ep_19 = ep') || ((ep_19 ≥ ep'' || ep' ≥ ep'') && (event(CompromisedAuth(x_32,y_11,sid_15,ep'')) || event(CompromisedAuth(y_11,x_32,sid_15,ep'')) || event(CompromisedAuth(x_32,y_11,sid',ep'')) || event(CompromisedAuth(y_11,x_32,sid',ep'')))) is true.
END *)
