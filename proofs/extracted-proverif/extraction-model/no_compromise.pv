(* SPQR extracted model — no compromise.
   Expect: no key is ever known to the attacker; key agreement, authentication
   and transcript authentication hold without exceptions; epoch 4 completes for
   both roles. *)

(* Saturation control (sound: nounif only guides ProVerif's resolution order,
   never the verdict): deprioritize the attacker building symbolic ML-KEM,
   authenticator, MAC and derived-secret terms. *)
nounif spqr_r: bitstring, hdr: bitstring, ss: bitstring;
    attacker(pkenc1(spqr_r, hdr, ss)) / 30000.
nounif spqr_r: bitstring, ek: bitstring;
    attacker(pkenc2(spqr_r, ek)) / 30000.
nounif dk: bitstring; attacker(dk2enckey(dk)) / 30000.
nounif dk: bitstring; attacker(dk2seed(dk)) / 30000.
nounif a: bitstring, e: bitstring, k: bitstring; attacker(auth_update(a, e, k)) / 30000.
nounif rk: bitstring, e: bitstring; attacker(auth_new(rk, e)) / 30000.
nounif a: bitstring, e: bitstring, ct: bitstring; attacker(mac_ct_f(a, e, ct)) / 30000.
nounif a: bitstring, e: bitstring, h: bitstring; attacker(mac_hdr_f(a, e, h)) / 30000.
nounif ss: bitstring, e: bitstring; attacker(derive_scka_secret_f(ss, e)) / 30000.

query sid: session_id, ep: nat, x, y: principal, sk: bitstring;
    event(EKSenderEmittedKey(sid, x, y, ep, sk)) && attacker(sk);
    event(CTSenderEmittedKey(sid, x, y, ep, sk)) && attacker(sk).

query sid: session_id, ep: nat, x, y: principal, sk: bitstring, hdr: bitstring;
    event(EKSenderEmittedKey(sid, x, y, ep, sk)) ==> event(CTSenderEmittedKey(sid, y, x, ep, sk));
    event(CTSenderEmittedKey(sid, x, y, ep, sk)) ==> event(EKSenderStarted(sid, y, x, ep));
    event(CTSenderEmittedKeyForHeader(sid, x, y, ep, hdr, sk)) ==> event(EKSenderSentHeader(sid, y, x, ep, hdr)).

query sid: session_id, ep: nat, x, y: principal, h, m, e: bitstring;
    event(AcceptedHdrEk(sid, x, y, ep, h, m, e)) ==> event(SentHdrEk(sid, y, x, ep, h, m, e));
    event(AcceptedCt(sid, x, y, ep, h, m, e)) ==> event(SentCt(sid, y, x, ep, h, m, e)).

query sid: session_id, sk: bitstring; event(EKSenderEmittedKey(sid, B, A, 4, sk)).
query sid: session_id, sk: bitstring; event(CTSenderEmittedKey(sid, A, B, 4, sk)).

process SystemNoCompromise()

(* EXPECTPV
RESULT not (event(EKSenderEmittedKey(sid_5,x_22,y_1,ep_9,sk)) && attacker(sk)) is true.
RESULT not (event(CTSenderEmittedKey(sid_5,x_22,y_1,ep_9,sk)) && attacker(sk)) is true.
RESULT event(EKSenderEmittedKey(sid_5,x_22,y_1,ep_9,sk)) ==> event(CTSenderEmittedKey(sid_5,y_1,x_22,ep_9,sk)) is true.
RESULT event(CTSenderEmittedKey(sid_5,x_22,y_1,ep_9,sk)) ==> event(EKSenderStarted(sid_5,y_1,x_22,ep_9)) is true.
RESULT event(CTSenderEmittedKeyForHeader(sid_5,x_22,y_1,ep_9,hdr_5,sk)) ==> event(EKSenderSentHeader(sid_5,y_1,x_22,ep_9,hdr_5)) is true.
RESULT event(AcceptedHdrEk(sid_5,x_22,y_1,ep_9,h,m,e_1)) ==> event(SentHdrEk(sid_5,y_1,x_22,ep_9,h,m,e_1)) is true.
RESULT event(AcceptedCt(sid_5,x_22,y_1,ep_9,h,m,e_1)) ==> event(SentCt(sid_5,y_1,x_22,ep_9,h,m,e_1)) is true.
RESULT not event(EKSenderEmittedKey(sid_5,B[],A[],4,sk)) is false.
RESULT not event(CTSenderEmittedKey(sid_5,A[],B[],4,sk)) is false.
END *)
