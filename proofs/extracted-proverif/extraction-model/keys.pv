(* SPQR extracted model — compromise of every state of both parties at every
   epoch, no authenticator.
   Expect: a key is known to the attacker only if a state of that same epoch was
   compromised; key agreement, authentication and transcript authentication hold
   without exceptions; the key of every epoch can leak. *)

(* Saturation control (sound: nounif only guides ProVerif's resolution order,
   never the verdict): deprioritize the attacker building symbolic ML-KEM,
   authenticator, MAC and derived-secret terms. *)
nounif spqr_r: bitstring, hdr: bitstring, ss: bitstring;
    attacker(pkenc1(spqr_r, hdr, ss)) / 30000.
nounif spqr_r: bitstring, ek: bitstring;
    attacker(pkenc2(spqr_r, ek)) / 30000.
nounif dk: bitstring; attacker(dk2enckey(dk)) / 30000.
nounif dk: bitstring; attacker(dk2seed(dk)) / 30000.
nounif a: bitstring, e: bitstring, k: bitstring; attacker(auth_update(a, e, k)) / 30000.
nounif rk: bitstring, e: bitstring; attacker(auth_new(rk, e)) / 30000.
nounif a: bitstring, e: bitstring, ct: bitstring; attacker(mac_ct_f(a, e, ct)) / 30000.
nounif a: bitstring, e: bitstring, h: bitstring; attacker(mac_hdr_f(a, e, h)) / 30000.
nounif ss: bitstring, e: bitstring; attacker(derive_scka_secret_f(ss, e)) / 30000.

query sid: session_id, ep: nat, x, y: principal, sk: bitstring;
    event(EKSenderEmittedKey(sid, x, y, ep, sk)) && attacker(sk) ==>
        event(CompromisedKeysHeaderSent(x, y, sid, ep))
        || event(CompromisedKeysEkSent(x, y, sid, ep))
        || event(CompromisedKeysEkSentCt1Received(x, y, sid, ep))
        || event(CompromisedKeysCt1Sent(y, x, sid, ep))
        || event(CompromisedKeysCt1SentEkReceived(y, x, sid, ep));
    event(CTSenderEmittedKey(sid, x, y, ep, sk)) && attacker(sk) ==>
        event(CompromisedKeysHeaderSent(y, x, sid, ep))
        || event(CompromisedKeysEkSent(y, x, sid, ep))
        || event(CompromisedKeysEkSentCt1Received(y, x, sid, ep))
        || event(CompromisedKeysCt1Sent(x, y, sid, ep))
        || event(CompromisedKeysCt1SentEkReceived(x, y, sid, ep)).

query sid: session_id, ep: nat, x, y: principal, sk: bitstring, hdr: bitstring;
    event(EKSenderEmittedKey(sid, x, y, ep, sk)) ==> event(CTSenderEmittedKey(sid, y, x, ep, sk));
    event(CTSenderEmittedKey(sid, x, y, ep, sk)) ==> event(EKSenderStarted(sid, y, x, ep));
    event(CTSenderEmittedKeyForHeader(sid, x, y, ep, hdr, sk)) ==> event(EKSenderSentHeader(sid, y, x, ep, hdr)).

query sid: session_id, ep: nat, x, y: principal, h, m, e: bitstring;
    event(AcceptedHdrEk(sid, x, y, ep, h, m, e)) ==> event(SentHdrEk(sid, y, x, ep, h, m, e));
    event(AcceptedCt(sid, x, y, ep, h, m, e)) ==> event(SentCt(sid, y, x, ep, h, m, e)).
query sid: session_id, sk: bitstring; event(EKSenderEmittedKey(sid, A, B, 1, sk)) && attacker(sk).
query sid: session_id, sk: bitstring; event(EKSenderEmittedKey(sid, B, A, 2, sk)) && attacker(sk).
query sid: session_id, sk: bitstring; event(EKSenderEmittedKey(sid, A, B, 3, sk)) && attacker(sk).
query sid: session_id, sk: bitstring; event(EKSenderEmittedKey(sid, B, A, 4, sk)) && attacker(sk).

process SystemKeys()

(* EXPECTPV
RESULT event(EKSenderEmittedKey(sid_13,x_30,y_9,ep_17,sk)) && attacker(sk) ==> event(CompromisedKeysHeaderSent(x_30,y_9,sid_13,ep_17)) || event(CompromisedKeysEkSent(x_30,y_9,sid_13,ep_17)) || event(CompromisedKeysEkSentCt1Received(x_30,y_9,sid_13,ep_17)) || event(CompromisedKeysCt1Sent(y_9,x_30,sid_13,ep_17)) || event(CompromisedKeysCt1SentEkReceived(y_9,x_30,sid_13,ep_17)) is true.
RESULT event(CTSenderEmittedKey(sid_13,x_30,y_9,ep_17,sk)) && attacker(sk) ==> event(CompromisedKeysHeaderSent(y_9,x_30,sid_13,ep_17)) || event(CompromisedKeysEkSent(y_9,x_30,sid_13,ep_17)) || event(CompromisedKeysEkSentCt1Received(y_9,x_30,sid_13,ep_17)) || event(CompromisedKeysCt1Sent(x_30,y_9,sid_13,ep_17)) || event(CompromisedKeysCt1SentEkReceived(x_30,y_9,sid_13,ep_17)) is true.
RESULT event(EKSenderEmittedKey(sid_13,x_30,y_9,ep_17,sk)) ==> event(CTSenderEmittedKey(sid_13,y_9,x_30,ep_17,sk)) is true.
RESULT event(CTSenderEmittedKey(sid_13,x_30,y_9,ep_17,sk)) ==> event(EKSenderStarted(sid_13,y_9,x_30,ep_17)) is true.
RESULT event(CTSenderEmittedKeyForHeader(sid_13,x_30,y_9,ep_17,hdr_5,sk)) ==> event(EKSenderSentHeader(sid_13,y_9,x_30,ep_17,hdr_5)) is true.
RESULT event(AcceptedHdrEk(sid_13,x_30,y_9,ep_17,h,m,e_1)) ==> event(SentHdrEk(sid_13,y_9,x_30,ep_17,h,m,e_1)) is true.
RESULT event(AcceptedCt(sid_13,x_30,y_9,ep_17,h,m,e_1)) ==> event(SentCt(sid_13,y_9,x_30,ep_17,h,m,e_1)) is true.
RESULT not (event(EKSenderEmittedKey(sid_13,A[],B[],1,sk)) && attacker(sk)) is false.
RESULT not (event(EKSenderEmittedKey(sid_13,B[],A[],2,sk)) && attacker(sk)) is false.
RESULT not (event(EKSenderEmittedKey(sid_13,A[],B[],3,sk)) && attacker(sk)) is false.
RESULT not (event(EKSenderEmittedKey(sid_13,B[],A[],4,sk)) && attacker(sk)) is false.
END *)
