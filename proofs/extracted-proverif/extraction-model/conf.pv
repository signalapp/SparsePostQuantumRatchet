(* SPQR extracted model — epoch key secrecy (forward secrecy and
   post-compromise security).
   Expect true: if the attacker knows a key a party emitted at epoch ep, then a
   state of epoch ep holding its secret was compromised (the decapsulation key of
   the EK sender, the encapsulation randomness of the CT sender), or an
   authenticator of an epoch ep' <= ep was compromised before the key was
   emitted. The compromise schedule (`System` in roles.pvl) is every state of
   both parties at every epoch, and both authenticators at epoch 3. *)

(* Saturation control (sound: nounif only guides ProVerif's resolution order,
   never the verdict): deprioritize the attacker building symbolic ML-KEM,
   authenticator, MAC and derived-secret terms. *)
nounif spqr_r: bitstring, hdr: bitstring, ss: bitstring;
    attacker(pkenc1(spqr_r, hdr, ss)) / 30000.
nounif spqr_r: bitstring, ek: bitstring;
    attacker(pkenc2(spqr_r, ek)) / 30000.
nounif dk: bitstring; attacker(dk2enckey(dk)) / 30000.
nounif dk: bitstring; attacker(dk2seed(dk)) / 30000.
nounif a: bitstring, e: bitstring, k: bitstring; attacker(auth_update(a, e, k)) / 30000.
nounif rk: bitstring, e: bitstring; attacker(auth_new(rk, e)) / 30000.
nounif a: bitstring, e: bitstring, ct: bitstring; attacker(mac_ct_f(a, e, ct)) / 30000.
nounif a: bitstring, e: bitstring, h: bitstring; attacker(mac_hdr_f(a, e, h)) / 30000.
nounif ss: bitstring, e: bitstring; attacker(derive_scka_secret_f(ss, e)) / 30000.

(* EK sender. *)
query i: time, j: time, sid: session_id, ep, ep': nat, x, y: principal, sk: bitstring;
    event(EKSenderEmittedKey(sid, x, y, ep, sk))@i && attacker(sk) ==>
        event(CompromisedKeysHeaderSent(x, y, sid, ep))
        || event(CompromisedKeysEkSent(x, y, sid, ep))
        || event(CompromisedKeysEkSentCt1Received(x, y, sid, ep))
        || event(CompromisedKeysCt1Sent(y, x, sid, ep))
        || event(CompromisedKeysCt1SentEkReceived(y, x, sid, ep))
        || (ep' <= ep && event(CompromisedAuth(x, y, sid, ep'))@j && j < i)
        || (ep' <= ep && event(CompromisedAuth(y, x, sid, ep'))@j && j < i).

(* CT sender, from send_ct1 on. *)
query i: time, j: time, sid: session_id, ep, ep': nat, x, y: principal, sk: bitstring;
    event(CTSenderEmittedKey(sid, x, y, ep, sk))@i && attacker(sk) ==>
        event(CompromisedKeysHeaderSent(y, x, sid, ep))
        || event(CompromisedKeysEkSent(y, x, sid, ep))
        || event(CompromisedKeysEkSentCt1Received(y, x, sid, ep))
        || event(CompromisedKeysCt1Sent(x, y, sid, ep))
        || event(CompromisedKeysCt1SentEkReceived(x, y, sid, ep))
        || (ep' <= ep && event(CompromisedAuth(x, y, sid, ep'))@j && j < i)
        || (ep' <= ep && event(CompromisedAuth(y, x, sid, ep'))@j && j < i).

process System()

(* EXPECTPV
RESULT event(EKSenderEmittedKey(sid_15,x_32,y_11,ep_19,sk))@i && attacker(sk) ==> event(CompromisedKeysHeaderSent(x_32,y_11,sid_15,ep_19)) || event(CompromisedKeysEkSent(x_32,y_11,sid_15,ep_19)) || event(CompromisedKeysEkSentCt1Received(x_32,y_11,sid_15,ep_19)) || event(CompromisedKeysCt1Sent(y_11,x_32,sid_15,ep_19)) || event(CompromisedKeysCt1SentEkReceived(y_11,x_32,sid_15,ep_19)) || (ep_19 ≥ ep' && event(CompromisedAuth(x_32,y_11,sid_15,ep'))@j && i > j) || (ep_19 ≥ ep' && event(CompromisedAuth(y_11,x_32,sid_15,ep'))@j && i > j) is true.
RESULT event(CTSenderEmittedKey(sid_15,x_32,y_11,ep_19,sk))@i && attacker(sk) ==> event(CompromisedKeysHeaderSent(y_11,x_32,sid_15,ep_19)) || event(CompromisedKeysEkSent(y_11,x_32,sid_15,ep_19)) || event(CompromisedKeysEkSentCt1Received(y_11,x_32,sid_15,ep_19)) || event(CompromisedKeysCt1Sent(x_32,y_11,sid_15,ep_19)) || event(CompromisedKeysCt1SentEkReceived(x_32,y_11,sid_15,ep_19)) || (ep_19 ≥ ep' && event(CompromisedAuth(x_32,y_11,sid_15,ep'))@j && i > j) || (ep_19 ≥ ep' && event(CompromisedAuth(y_11,x_32,sid_15,ep'))@j && i > j) is true.
END *)
